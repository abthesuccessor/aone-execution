{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "nodes", "relationships"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "title",
          "objective",
          "agentId",
          "dependsOn",
          "acceptanceCriteria",
          "inputs",
          "outputs",
          "traceability"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "domain": { "type": "string", "minLength": 1, "maxLength": 120 },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "objective": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "agentId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 200 },
            "maxItems": 100
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "required", "provenanceRequired"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "type": { "type": "string", "minLength": 1, "maxLength": 200 },
                "required": { "type": "boolean" },
                "provenanceRequired": { "type": "boolean" }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "required", "provenanceRequired"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "type": { "type": "string", "minLength": 1, "maxLength": 200 },
                "required": { "type": "boolean" },
                "provenanceRequired": { "type": "boolean" }
              }
            }
          },
          "traceability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intentNodeIds", "evidenceIds"],
            "properties": {
              "intentNodeIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "evidenceIds": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source", "target", "rationale", "traceability"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
          "source": { "type": "string", "minLength": 1, "maxLength": 200 },
          "target": { "type": "string", "minLength": 1, "maxLength": 200 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "traceability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intentNodeIds", "evidenceIds"],
            "properties": {
              "intentNodeIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "evidenceIds": {
                "type": "array",
                "maxItems": 100,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      }
    }
  }
}
